APP_NAME=dulaedee
APP_ENV=development
PORT=3200
JWT_SECRET_KEY=change-me

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=dulaedee

# comma-separated
CORS_ORIGINS=http://localhost:5190

# SPA origin ที่ Google callback redirect กลับไป (default = CORS_ORIGINS ตัวแรก)
CLIENT_URL=http://localhost:5190

# Google OAuth — สร้างที่ Google Cloud Console > Credentials > OAuth client ID (Web application)
# Authorized redirect URI ต้องตรงกับ GOOGLE_OAUTH_REDIRECT_URL · สร้างใหม่ต่อโปรเจกต์ อย่าใช้ของโปรเจกต์อื่น
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3200/auth/google/callback

# รหัส admin คนแรกตอนฐานข้อมูลว่าง · ว่าง = สุ่มแล้วพิมพ์ลง log ครั้งเดียว
SEED_ADMIN_PASSWORD=

# อีเมลลืมรหัสผ่าน · ว่าง = พิมพ์ลิงก์ลง log ของ server แทน (ทดสอบบนเครื่องได้)
# ใช้ฟรีด้วย Gmail + App Password: smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=

# Web Push · ว่าง = ปิดการแจ้งเตือน · สร้างด้วย npx web-push generate-vapid-keys (ฟรี)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# จำนวนชั้น reverse proxy หน้า API (เช่น 1 เมื่ออยู่หลัง nginx หรือ Render) ใช้ให้ rate limit เห็น IP จริง · ว่าง = ไม่มี proxy
TRUST_PROXY=
